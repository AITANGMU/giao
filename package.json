{
  "name": "visual-pet",
  "version": "1.1.0",
  "description": "虚拟桌宠 —— 一个会在桌面散步、说话、提醒你的 Electron 小宠物",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.visualpet.app",
    "productName": "桌宠",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "search.js",
      "knowledge.js",
      "renderer/**/*",
      "assets/**/*",
      "!assets/pet-image.jpg",
      "knowledge/memory.json",
      "knowledge/使用说明.txt",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/pet-256.ico"
    },
    "portable": {
      "artifactName": "桌宠-${version}-便携版.exe"
    }
  }
}
